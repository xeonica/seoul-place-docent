# Copy to .env.local for native Next.js development.
# In Vercel, enter these as server-side Environment Variables (never NEXT_PUBLIC_*).
JUSO_API_KEY=
BUILDING_API_KEY=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
NATIONAL_ARCHIVES_API_KEY=
SEOUL_PHOTOS_API_KEY=
PERMIT_API_KEY=
CLOSED_BUILDING_API_KEY=
VWORLD_API_KEY=
SEOUL_OPEN_DATA_API_KEY=

# Existing Cloudflare D1 database; token needs D1 access on this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Existing R2 bucket; use bucket-scoped S3 credentials.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin requests use x-archive-admin. Sites identity headers are not trusted here.
ARCHIVE_ADMIN_TOKEN=

# Separate public MCP endpoint shown on the existing homepage (no credentials).
MCP_PUBLIC_URL=
# Optional exact browser origins. Server-to-server requests omit Origin.
MCP_ALLOWED_ORIGINS=

# Optional Google BigQuery source. Keep disabled until a dataset and identity federation are configured.
BIGQUERY_ENABLED=false
BIGQUERY_PROJECT_ID=
BIGQUERY_DATASET_ID=
BIGQUERY_LOCATION=
BIGQUERY_MAX_BYTES_BILLED=104857600
BIGQUERY_QUERY_TIMEOUT_MS=8000
BIGQUERY_QUERY_MAX_RESULTS=8
# Vercel OIDC → Google Workload Identity Federation (no service-account JSON key).
BIGQUERY_WIF_PROJECT_NUMBER=
BIGQUERY_WIF_POOL_ID=
BIGQUERY_WIF_PROVIDER_ID=
BIGQUERY_SERVICE_ACCOUNT_EMAIL=
# Local only: short-lived token from `gcloud auth application-default print-access-token`; do not commit it.
BIGQUERY_ACCESS_TOKEN=
