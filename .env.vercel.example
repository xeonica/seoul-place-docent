# Copy to .env.local for native Next.js development.
# In Vercel, enter these as server-side Environment Variables (never NEXT_PUBLIC_*).
JUSO_API_KEY=
BUILDING_API_KEY=
KAKAO_REST_API_KEY=
KAKAO_JAVASCRIPT_KEY=
OPENAI_API_KEY=
OPENAI_MODEL=
NATIONAL_ARCHIVES_API_KEY=
SEOUL_PHOTOS_API_KEY=
PERMIT_API_KEY=
CLOSED_BUILDING_API_KEY=
VWORLD_API_KEY=
SEOUL_OPEN_DATA_API_KEY=

# Existing Cloudflare D1 database; token needs D1 access on this account.
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_D1_DATABASE_ID=
CLOUDFLARE_D1_API_TOKEN=

# Existing R2 bucket; use bucket-scoped S3 credentials.
R2_BUCKET_NAME=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=

# Admin requests use x-archive-admin. Sites identity headers are not trusted here.
ARCHIVE_ADMIN_TOKEN=

# Separate public MCP endpoint shown on the existing homepage (no credentials).
MCP_PUBLIC_URL=
# Optional exact browser origins. Server-to-server requests omit Origin.
MCP_ALLOWED_ORIGINS=

# Existing Vercel OIDC -> GCP Workload Identity Federation (no service account key).
GCP_PROJECT_ID=seoul-docent-archive
GCP_PROJECT_NUMBER=
GCP_WORKLOAD_IDENTITY_POOL_ID=
GCP_WORKLOAD_IDENTITY_POOL_PROVIDER_ID=
GCP_SERVICE_ACCOUNT_EMAIL=
BIGQUERY_LOCATION=asia-northeast3
# Opt in only after additive SQL/import is verified. Empty keeps legacy view.
BIGQUERY_PLACE_SERVING_VERSION=
# Public candidate metadata only; 60-second instance cache. off disables it.
# Current D1 approvals and credentials are never persisted in this cache.
MCP_PUBLIC_METADATA_CACHE=
